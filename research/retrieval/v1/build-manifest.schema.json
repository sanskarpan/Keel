{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.example/schemas/retrieval-build-v1.json",
  "title": "Keel retrieval build manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "analyzer_id", "chunker", "embedding_model", "corpus_build_id", "distance", "evaluation_dataset_id", "evaluation_corpus_sha256", "evaluation_only"],
  "properties": {
    "manifest_version": {"const": "keel.retrieval-build.v1"},
    "analyzer_id": {"type": "string", "minLength": 3},
    "chunker": {"type": "object", "additionalProperties": false, "required": ["id", "max_tokens", "overlap_tokens", "max_source_bytes", "heading_context"], "properties": {"id": {"type": "string"}, "max_tokens": {"type": "integer", "minimum": 1, "maximum": 2048}, "overlap_tokens": {"type": "integer", "minimum": 0}, "max_source_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "heading_context": {"type": "boolean"}}},
    "embedding_model": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "revision", "artifact_sha256", "tokenizer_id", "dimensions", "max_input_tokens", "normalize"], "properties": {"id": {"type": "string"}, "provider": {"type": "string"}, "revision": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "tokenizer_id": {"type": "string"}, "dimensions": {"type": "integer", "minimum": 1, "maximum": 8192}, "max_input_tokens": {"type": "integer", "minimum": 1}, "normalize": {"type": "boolean"}}, "description": "Immutable ID and artifact identity; mutable latest/default aliases are not allowed."},
    "corpus_build_id": {"type": "string", "minLength": 3},
    "distance": {"enum": ["cosine", "dot", "l2"]},
    "evaluation_dataset_id": {"type": "string", "minLength": 3},
    "evaluation_corpus_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "evaluation_only": {"const": true}
  }
}
